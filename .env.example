# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает (см. .gitignore).

# Окружение: local | staging | production
ENVIRONMENT=local
DEBUG=false

# Подключение к базе. Для локальной разработки через docker compose оставьте как есть.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/app

# Ключ подписи токенов. Не короче 32 байт (RFC 7518).
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=

# Время жизни токена доступа, минут
ACCESS_TOKEN_TTL_MINUTES=60

# Разрешённые источники для CORS через запятую. Пусто — кросс-доменные запросы запрещены.
CORS_ORIGINS=

# Параметры БД для docker compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
